{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vitralxx.github.io/Khalkaria_Html/data/ficha.schema.json",
  "title": "Ficha de Personagem Khalkaria (v3)",
  "description": "Ficha nativa v3 (schemaVersion '3.0'), uma por personagem: várias fichas por navegador com seletor (D36). Gravada em 'khalkaria_ficha_v3:<id>' a partir da F4 (na F3 é só memória: modo sombra) e no Export JSON. O índice das fichas e o 'exportar todas' estão em $defs/indiceFichas e $defs/pacoteFichas (schema 'fichas/1'). Campos derivados (modificadores, totais de perícia, máximos, Evasão, CD, Movimento, Ar/Ae, capacidade) NÃO são guardados: o motor calcula; o que o jogador corrige à mão vai em 'ajustes' (M2). Motor puro: js/ficha/kh-estado.js (KhEstado). A ficha v2.1 ativa segue descrita em data/ficha-v2.schema.json. Validado nos testes pelo validador mínimo tools/testes/esquema-min.js (sem pip): só as palavras-chave que ele conhece.",
  "type": "object",
  "required": ["schemaVersion", "id", "rev", "meta", "identidade", "atributos", "pericias", "recursos", "condicoes", "entradas", "inventario", "ajustes", "resistencias", "limiar", "vhelor", "lore"],
  "additionalProperties": false,

  "properties": {
    "schemaVersion": { "type": "string", "const": "3.0", "description": "1.0 e 2.0 entram só por migração em cadeia (KhEstado.migrar). Versão maior que 3 é recusada (guarda anti-downgrade): nem import, nem gravação por cima." },
    "id": { "type": "string", "pattern": "^f[a-z0-9]{6,}$", "description": "Aleatório, gerado na criação (ou na migração/import sem id). Chave 'khalkaria_ficha_v3:<id>'." },
    "rev": { "type": "integer", "minimum": 0, "description": "Contador de gravações desta ficha; o armazém recusa gravar por cima de um rev maior (outra aba gravou)." },
    "criadoEm": { "type": "string" },
    "salvoEm": { "type": "string" },
    "exportadoEm": { "type": "string" },

    "meta": {
      "type": "object",
      "required": ["nome", "nivel"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string" },
        "jogador": { "type": "string" },
        "nivel": { "type": "integer", "minimum": 1, "maximum": 5 },
        "xp": { "type": "integer", "minimum": 0 }
      }
    },

    "identidade": {
      "type": "object",
      "description": "Por id do catálogo; 'nome' é cache (e o texto livre da v2 quando não achou par: id null).",
      "required": ["raca", "variante", "classe", "ramo", "origem"],
      "additionalProperties": false,
      "properties": {
        "raca": { "$ref": "#/$defs/refIdentidade" },
        "variante": { "$ref": "#/$defs/refIdentidade" },
        "subespecie": { "$ref": "#/$defs/refIdentidade" },
        "classe": { "$ref": "#/$defs/refIdentidade" },
        "ramo": { "$ref": "#/$defs/refIdentidade" },
        "origem": { "$ref": "#/$defs/refIdentidade" },
        "escolhas": { "type": "object", "description": "Escolhas de raça/classe/origem (atributo com 'ou', perícias de escolha…), por chave do bloco de dado. Livre até a F4c." }
      }
    },

    "atributos": {
      "type": "object",
      "description": "base = os 5 valores distribuídos na criação (8–18 rolados, D30; o ponto movido pode passar da faixa). O total (base + raça + porNivel + cartas + itens) é derivado. Na migração da v2 o total digitado vira a base com migradoTotal:true (raça e nível já estão dentro; o motor não soma de novo).",
      "required": ["base", "porNivel", "migradoTotal"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/$defs/porAtributo" },
        "fonte": { "type": ["string", "null"], "enum": ["rolado", "manual", "migrado", null] },
        "porNivel": {
          "type": "object",
          "description": "+2 pontos por nível, níveis 2–5 (atributos.ganhoPorNivel do contrato): {'2': {'FOR': 1, 'DES': 1}}.",
          "propertyNames": { "enum": ["2", "3", "4", "5"] },
          "additionalProperties": { "$ref": "#/$defs/ganhoAtributo" }
        },
        "pontoMovido": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["de", "para"], "additionalProperties": false,
              "properties": { "de": { "$ref": "#/$defs/atributo" }, "para": { "$ref": "#/$defs/atributo" } } }
          ]
        },
        "migradoTotal": { "type": "boolean" },
        "nivelMigrado": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 }
      }
    },

    "pericias": {
      "type": "object",
      "description": "As 24 perícias de data/pericias.json, valor = GRAU 0–4 (0 Leigo, 1 Treinado +2, 2 Experiente +4, 3 Mestre +6, 4 Lendário +8). O Bestiário recebe o mesmo grau (D5a).",
      "required": ["atacar", "defender", "movimento", "fortitude", "vontade", "reflexos", "percepcao", "sobrevivencia", "furtividade", "crime", "iniciativa", "conhecimento", "medicina", "investigacao", "religiao", "mistico", "convencimento", "intimidacao", "intuicao", "enganacao", "motivar", "oficio-engenharia", "oficio-ferraria", "oficio-alquimia"],
      "propertyNames": { "enum": ["atacar", "defender", "movimento", "fortitude", "vontade", "reflexos", "percepcao", "sobrevivencia", "furtividade", "crime", "iniciativa", "conhecimento", "medicina", "investigacao", "religiao", "mistico", "convencimento", "intimidacao", "intuicao", "enganacao", "motivar", "oficio-engenharia", "oficio-ferraria", "oficio-alquimia"] },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4 }
    },
    "periciasAttr": {
      "type": "object",
      "description": "D7: nas 4 perícias de modo 'maior' vale o maior atributo, com troca à mão. Ausente = o maior.",
      "additionalProperties": false,
      "properties": {
        "movimento": { "enum": ["FOR", "DES"] },
        "convencimento": { "enum": ["DES", "INT"] },
        "intimidacao": { "enum": ["CON", "FOR"] },
        "enganacao": { "enum": ["DES", "INT"] }
      }
    },

    "recursos": {
      "type": "object",
      "description": "Só o ESTADO (edição direta, M2 b). Os máximos são derivados (V/G/R × nível); correção à mão vai em ajustes 'recurso.<r>.max'.",
      "required": ["saude", "stamina", "eter", "classe"],
      "additionalProperties": false,
      "properties": {
        "saude": { "type": "object", "required": ["atual"], "additionalProperties": false,
          "properties": { "atual": { "type": "number" }, "temporaria": { "type": "number", "minimum": 0, "description": "D15: não soma (fica a maior), gasta primeiro, some no descanso longo." } } },
        "stamina": { "type": "object", "required": ["atual"], "additionalProperties": false,
          "properties": { "atual": { "type": "number" }, "comprometida": { "type": "number", "minimum": 0, "description": "D19: reserva visível como comprometida." } } },
        "eter": { "type": "object", "required": ["atual"], "additionalProperties": false,
          "properties": { "atual": { "type": "number" } } },
        "classe": { "type": "object", "required": ["atual"], "additionalProperties": false,
          "description": "Recurso de classe (medidor do bloco classe: FLUXO, Instinto, Brutalidade, Reagentes, Concentração). Espadachim e Teurgo têm recurso (Pedro, 2026-09-26) mas o nome ainda não está no contrato: id null e selo PENDENTE (balanceamento).",
          "properties": { "id": { "type": ["string", "null"] }, "nome": { "type": "string" }, "atual": { "type": "number" } } }
      }
    },

    "condicoes": {
      "type": "array",
      "description": "Condições ativas, por referência (id de data/condicoes.json + Agarrado). X é intensidade (Lento X, Sangramento X…); a duração conta em turnos seus ou termina num evento.",
      "items": { "$ref": "#/$defs/condicaoAtiva" }
    },

    "entradas": {
      "type": "array",
      "description": "Tudo que foi levado à ficha, menos item (inventário) e condição: por referência {tipo, id} com cache para mostrar sem catálogo e sem rede. Id que sumiu (ou migração sem par) vira órfã e nunca é apagada.",
      "items": { "$ref": "#/$defs/entrada" }
    },

    "inventario": {
      "type": "object",
      "description": "O do KhInv (js/ficha/kh-inv.js), igual à v2: ver data/ficha-v2.schema.json $defs/entradaInventario.",
      "required": ["sins", "bugigangas", "equipamentos"],
      "additionalProperties": false,
      "properties": {
        "sins": { "type": "integer", "minimum": 0 },
        "bugigangas": { "type": "array", "items": { "$ref": "#/$defs/entradaInventario" } },
        "equipamentos": { "type": "array", "items": { "$ref": "#/$defs/entradaInventario" } }
      }
    },

    "ajustes": {
      "type": "object",
      "description": "M2: ajuste manual de campo DERIVADO, marcado e removível; a conta continua visível. Chave = caminho do namespace de derivados; caminho de estado (recurso.*.atual, base de atributo, grau de perícia, Sins…) é recusado. O padrão abaixo é o KhEstado.PADRAO_AJUSTE (o teste compara).",
      "propertyNames": { "pattern": "^(?:atributo\\.(?:FOR|DES|CON|INT|SAB)\\.(?:total|mod)|pericia\\.(?:atacar|defender|movimento|fortitude|vontade|reflexos|percepcao|sobrevivencia|furtividade|crime|iniciativa|conhecimento|medicina|investigacao|religiao|mistico|convencimento|intimidacao|intuicao|enganacao|motivar|oficio-engenharia|oficio-ferraria|oficio-alquimia)\\.total|recurso\\.(?:saude|stamina|eter|classe)\\.max|evasao\\.(?:passiva|ativa)|cd|movimento|ar|acoes|capacidade\\.(?:bugigangas|equipamentos)|ae\\.(?:cortante|contundente|perfurante|fogo|frio|eletrico|veneno|acido|psiquico|radiante|trovejante|necrotico|forca|primordial|ordinario|elemental|biologico|mistico|todos)|(?:resistencia|imunidade|vulnerabilidade)\\.(?:cortante|contundente|perfurante|fogo|frio|eletrico|veneno|acido|psiquico|radiante|trovejante|necrotico|forca|primordial)|magia\\.[a-z0-9-]+\\.custo|ataque\\.[A-Za-z0-9_-]+\\.(?:atacar|dano)|limiar\\.saldo)$" },
      "additionalProperties": { "$ref": "#/$defs/ajuste" }
    },

    "resistencias": {
      "type": "object",
      "description": "Marcação MANUAL de base (fonte 'ficha'), por cima da qual o motor soma raça, itens e condições. 14 tipos (D63/D67) com R, I, V e Ae; Ae de categoria (Ordinário, Elemental, Biológico, Místico) e Ae(Todos). A v2 tinha 'ordinario' como tipo: migra para os 3 tipos (R/I) e para a Ae de categoria.",
      "required": ["tipos", "aeCategoria", "aeTodos"],
      "additionalProperties": false,
      "properties": {
        "tipos": {
          "type": "object",
          "required": ["cortante", "contundente", "perfurante", "fogo", "frio", "eletrico", "veneno", "acido", "psiquico", "radiante", "trovejante", "necrotico", "forca", "primordial"],
          "propertyNames": { "enum": ["cortante", "contundente", "perfurante", "fogo", "frio", "eletrico", "veneno", "acido", "psiquico", "radiante", "trovejante", "necrotico", "forca", "primordial"] },
          "additionalProperties": { "$ref": "#/$defs/defesaTipo" }
        },
        "aeCategoria": {
          "type": "object",
          "propertyNames": { "enum": ["ordinario", "elemental", "biologico", "mistico"] },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "aeTodos": { "type": "integer", "minimum": 0 }
      }
    },

    "imunidadesCondicao": { "type": "array", "items": { "type": "string" }, "description": "Imunidade a condição marcada à mão (ids de condição)." },
    "idiomas": { "type": "array", "items": { "type": "string" } },

    "limiar": {
      "type": "object",
      "required": ["queimadas"],
      "additionalProperties": false,
      "properties": {
        "queimadas": { "type": "array", "description": "D35: 1 carta queimada por mão; nunca mais volta (aviso, sem trava).",
          "items": { "type": "object", "required": ["id", "nivel"], "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "nivel": { "type": "integer", "minimum": 2, "maximum": 5 } } } }
      }
    },

    "historicoNivel": { "type": "array", "description": "Uma entrada por criação/subida (M3); a 0 leva as rolagens da criação.", "items": { "type": "object" } },

    "vhelor": {
      "type": "object",
      "required": ["marcas"],
      "additionalProperties": false,
      "properties": { "marcas": { "type": "integer", "minimum": 0, "maximum": 7, "description": "Marcas da Vhelor (M5, D26a). O texto das 7 mora em data/balanceamento/marcas-vhelor.json." } }
    },

    "lore": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "historia": { "type": "string" }, "outros": { "type": "string" } }
    },

    "migracao": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["de", "em", "pendencias"], "additionalProperties": false,
          "properties": {
            "de": { "enum": ["1.0", "2.0"] },
            "em": { "type": "string" },
            "pendencias": { "type": "array", "description": "O que a migração não pode decidir pelo jogador (ex.: qual Ofício recebe o grau do Ofício(X) da v2).", "items": { "type": "object", "required": ["campo", "motivo"] } }
          } }
      ]
    },
    "vinculoV2": {
      "description": "Ficha que veio da v2: rev e salvoEm da v2 no momento da migração (para 'reimportar alterações da v2', F4). A cópia (duplicar) não herda.",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["revV2", "salvoEmV2"], "additionalProperties": false,
          "properties": { "revV2": { "type": "integer", "minimum": 0 }, "salvoEmV2": { "type": "string" } } }
      ]
    },

    "estadoSessao": { "$ref": "#/$defs/sessao", "description": "Só no EXPORT nativo: a sessão da Mesa desta ficha (no navegador fica em 'khalkaria_ficha_v3_sessao:<id>'). Nunca vai ao Bestiário." }
  },

  "$defs": {
    "atributo": { "enum": ["FOR", "DES", "CON", "INT", "SAB"] },
    "porAtributo": {
      "type": "object",
      "required": ["FOR", "DES", "CON", "INT", "SAB"],
      "additionalProperties": false,
      "properties": {
        "FOR": { "type": "integer", "minimum": 1, "maximum": 30 },
        "DES": { "type": "integer", "minimum": 1, "maximum": 30 },
        "CON": { "type": "integer", "minimum": 1, "maximum": 30 },
        "INT": { "type": "integer", "minimum": 1, "maximum": 30 },
        "SAB": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "ganhoAtributo": {
      "type": "object",
      "propertyNames": { "enum": ["FOR", "DES", "CON", "INT", "SAB"] },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 2 }
    },

    "refIdentidade": {
      "type": "object",
      "required": ["id", "nome"],
      "additionalProperties": false,
      "properties": { "id": { "type": ["string", "null"] }, "nome": { "type": "string" } }
    },

    "cache": {
      "type": "object",
      "required": ["nome", "versaoCatalogo"],
      "additionalProperties": false,
      "properties": {
        "nome": { "type": "string" },
        "resumo": { "type": "string" },
        "versaoCatalogo": { "type": "string" }
      }
    },

    "orfao": {
      "type": "object",
      "required": ["motivo"],
      "additionalProperties": false,
      "properties": {
        "motivo": { "enum": ["sumiu", "sem-par", "ambiguo", "sem-catalogo", "tipo-desconhecido"], "description": "sumiu: o id saiu do catálogo; sem-par/ambiguo: migração por nome+tipo+classe; sem-catalogo: migrou sem catálogo (reassociar tenta de novo)." },
        "candidatos": { "type": "array", "items": { "type": "string" } }
      }
    },

    "entrada": {
      "type": "object",
      "required": ["uid", "tipo", "id", "estado", "cache", "mods"],
      "additionalProperties": false,
      "properties": {
        "uid": { "type": "string", "minLength": 1 },
        "tipo": { "enum": ["magia", "tecnica", "marca", "ultimate", "traco", "variante", "subespecie", "tecnologia", "corrupcao", "origem", "raca", "classe", "carta", "dor", "beneficio"] },
        "id": { "type": ["string", "null"], "description": "Id do catálogo (convenção do plano §3.2); null na órfã da migração." },
        "estado": { "type": "object", "description": "Por tipo (plano §4): magia {intensidade, sustentando}; tecnica/marca/ultimate {usos}; carta {nivelAquisicao, posicaoNaMao, especial}; dor/beneficio/corrupcao {nivelAquisicao}." },
        "cache": { "$ref": "#/$defs/cache" },
        "mods": { "type": "array", "items": { "$ref": "#/$defs/mod" }, "description": "Snapshot dos Mods (o derivado calcula síncrono sem o catálogo)." },
        "adicionadoEm": { "type": "string" },
        "nivelAquisicao": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "migradoDe": { "type": "object", "required": ["id", "tipo", "nome"], "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "tipo": { "type": "string" }, "nome": { "type": "string" } } },
        "orfao": { "$ref": "#/$defs/orfao" }
      }
    },

    "mod": {
      "type": "object",
      "required": ["alvo", "op"],
      "description": "Mod do site (plano §4). Vocabulário completo validado no gerar_efeitos.py; aqui só a forma.",
      "properties": {
        "alvo": { "type": "string" },
        "op": { "enum": ["soma", "multiplica", "fixa", "minimo", "maximo", "vantagem", "desvantagem", "falhaAuto", "semAcao", "semReacao", "lembrete", "escolha"] },
        "status": { "type": "string" }
      }
    },

    "condicaoAtiva": {
      "type": "object",
      "required": ["uid", "id", "x", "duracao"],
      "additionalProperties": false,
      "properties": {
        "uid": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": ["integer", "null"], "minimum": 0, "description": "Intensidade; null na condição sem X." },
        "duracao": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "required": ["turnosSeus"], "additionalProperties": false,
              "properties": { "turnosSeus": { "type": "integer", "minimum": 0 } } },
            { "type": "object", "required": ["ate"], "additionalProperties": false,
              "properties": { "ate": { "enum": ["fimTurno", "fimCombate", "fimCena", "descansoCurto", "descansoLongo", "novoDia", "manual"] } } }
          ]
        },
        "fonte": { "type": ["object", "null"] },
        "cache": { "$ref": "#/$defs/cache" },
        "desde": { "type": "string" }
      }
    },

    "ajuste": {
      "type": "object",
      "required": ["modo", "valor", "desde"],
      "additionalProperties": false,
      "properties": {
        "modo": { "enum": ["fixa", "soma"], "description": "fixa: o campo vira o valor; soma: diferença sobre o calculado (acompanha o nível)." },
        "valor": { "type": ["number", "boolean"], "description": "boolean só em resistencia/imunidade/vulnerabilidade.<tipo> (e aí só 'fixa')." },
        "motivo": { "type": "string" },
        "temporario": {
          "oneOf": [
            { "const": false },
            { "type": "object", "required": ["fim"], "additionalProperties": false,
              "properties": { "fim": { "enum": ["fimTurno", "fimCombate", "descansoCurto", "descansoLongo", "manual"] } } }
          ]
        },
        "desde": { "type": "string" },
        "calculadoEm": { "type": ["number", "null"], "description": "O calculado quando o ajuste foi feito (o chip avisa se mudou). null: ainda não conferido (migração sem o motor)." },
        "origem": { "enum": ["manual", "migracao"] }
      }
    },

    "defesaTipo": {
      "type": "object",
      "required": ["R", "I", "V", "ae"],
      "additionalProperties": false,
      "properties": {
        "R": { "type": "boolean" }, "I": { "type": "boolean" }, "V": { "type": "boolean" },
        "ae": { "type": "integer", "minimum": 0 }
      }
    },

    "entradaInventario": {
      "type": "object",
      "required": ["uid", "id", "nome", "qtd", "empilhavel", "equipado", "sintonizado", "avulso"],
      "description": "Igual à v2 (data/ficha-v2.schema.json $defs/entradaInventario); os estados da F6 (ativo, escolhas, usosGastos, temporarios) entram por cima.",
      "properties": {
        "uid": { "type": "string" },
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "qtd": { "type": "integer", "minimum": 1, "maximum": 9999 },
        "empilhavel": { "type": "boolean" },
        "equipado": { "type": "boolean" },
        "sintonizado": { "type": "boolean" },
        "avulso": { "type": "boolean" }
      }
    },

    "sessao": {
      "type": "object",
      "description": "Sessão da Mesa (M1), por ficha, fora do rev: não entra no desfazer.",
      "additionalProperties": false,
      "properties": {
        "modo": { "enum": ["ficha", "mesa"] },
        "turno": { "type": "integer", "minimum": 0 },
        "acoesGastas": { "type": "integer", "minimum": 0 },
        "reacaoGasta": { "type": "boolean" },
        "magiaDoTurno": { "type": ["string", "null"] },
        "sustentando": { "type": ["string", "null"] },
        "agressorAtual": { "type": ["string", "null"] },
        "log": { "type": "array", "maxItems": 200, "items": { "type": "object", "required": ["t", "tipo", "texto"],
          "properties": { "t": { "type": "string" }, "tipo": { "enum": ["rolagem", "acao"] }, "texto": { "type": "string" } } } }
      }
    },

    "logDesfazer": {
      "type": "object",
      "description": "Desfazer por ficha em 'khalkaria_ficha_v3_log:<id>': teto de 20 passos e 256 KB; não vai no export.",
      "required": ["passos"],
      "additionalProperties": false,
      "properties": {
        "passos": { "type": "array", "maxItems": 20, "items": { "type": "object", "required": ["revPorParte", "partes", "antes", "rotulo"] } }
      }
    },

    "linhaIndice": {
      "type": "object",
      "required": ["id", "nome", "classe", "nivel", "atualizadoEm"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" }, "nome": { "type": "string" }, "classe": { "type": "string" },
        "nivel": { "type": "integer", "minimum": 1, "maximum": 5 }, "atualizadoEm": { "type": "string" }
      }
    },
    "indiceFichas": {
      "type": "object",
      "description": "'khalkaria_fichas_v3': vitrine do seletor. A fonte é a ficha; a linha dela é atualizada na mesma gravação. A ativa é por aba (sessionStorage 'khalkaria_ficha_ativa'); ultimaAtiva é a que abre numa aba nova.",
      "required": ["schema", "ultimaAtiva", "fichas"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "fichas/1" },
        "ultimaAtiva": { "type": ["string", "null"] },
        "projecaoV2": { "oneOf": [ { "type": "null" },
          { "type": "object", "required": ["fichaId", "revV2", "salvoEmV2"], "additionalProperties": false,
            "properties": { "fichaId": { "type": "string" }, "revV2": { "type": "integer", "minimum": 0 }, "salvoEmV2": { "type": "string" } } } ] },
        "fichas": { "type": "array", "items": { "$ref": "#/$defs/linhaIndice" } }
      }
    },
    "pacoteFichas": {
      "type": "object",
      "description": "'Exportar todas' (khalkaria-fichas.json). Cada item é o export nativo de uma ficha (a ficha + estadoSessao). Importar aceita este pacote ou uma ficha só.",
      "required": ["schema", "fichas"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "fichas/1" },
        "exportadoEm": { "type": "string" },
        "fichas": { "type": "array", "items": { "$ref": "#" } }
      }
    }
  }
}
