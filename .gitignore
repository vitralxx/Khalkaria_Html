# Snapshots do Notion: só o manifesto é versionado (CLAUDE.md §9)
notion_cache/*
!notion_cache/pages.json

# Ruído de sistema / empacotamento (CLAUDE.md §8)
.DS_Store
__MACOSX/
old_ref/
__pycache__/
*.pyc

# Dumps e referências de trabalho local (não fazem parte do site publicado)
preview.txt
site_v24/
*.tmp

# Verbatim do balanceamento e raras (F1d/F1f, plano M6): nunca versionado
privado/

# Capturas de estilo computado (tools/estilo/): só a linha de base é versionada;
# antes2/depois/etc. são rodadas locais de conferência
tools/testes/estilo/*
!tools/testes/estilo/antes/
